{
  "name": "shubao",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "verify": "node scripts/verify-exports.mjs",
    "test": "node --test --test-concurrency=1 --test-skip-pattern=\"VideoCanvasWorkbench.jsx 接入|handleCreateExportManifest|renderVideo 接受最小 manifest|ffmpeg adapter\" test/*.test.mjs",
    "build": "node scripts/verify-exports.mjs && vite build",
    "check": "node scripts/check-build.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "verify:video-workbench-pilot": "node scripts/verify-video-workbench-pilot.mjs",
    "verify:video-renderer-reconciliation-dry-run": "node scripts/verify-video-renderer-reconciliation-dry-run.mjs",
    "verify:video-acceptance": "node scripts/verify-ai-video-acceptance.mjs",
    "collab:check": "node scripts/collaboration-policy.mjs",
    "images:thumbs": "node scripts/generate-image-thumbs.mjs",
    "preview": "vite preview",
    "start": "concurrently \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tus/file-store": "2.1.1",
    "@tus/server": "2.4.1",
    "@xyflow/react": "^12.11.5",
    "ag-psd": "31.0.2",
    "better-sqlite3": "^12.11.1",
    "canvas": "3.2.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "4.22.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.33.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.3",
    "onnxruntime-web": "1.27.0",
    "react": "^18.3.1",
    "react-colorful": "^5.8.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.2",
    "stripe": "^22.3.1",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "pm2": "^7.0.4",
    "vite": "^6.0.0"
  }
}
