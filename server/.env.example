# ── 薯包AI 环境变量配置 ──
# 复制为 .env 后填入真实密钥

# LLM API（内容分析 - 主力模型）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Mini API（Vision 分析 - 参考图理解）
MINI_API_KEY=sk-your-key-here
MINI_BASE_URL=https://api2.65535.space
MINI_MODEL=gpt-5.6-luna
VISUAL_ANALYSIS_PROMPT_VERSION=visual-analysis-v3

# 图片生成 API（GPT-Image-2 中转站）
IMAGE_API_KEY=sk-your-key-here
IMAGE_PRIMARY_BASE_URL=https://task-api-1-cn.65535.space
IMAGE_OVERFLOW_BASE_URL=
IMAGE_BASE_URL=
IMAGE_AUTH_STRATEGY=bearer
IMAGE_PROVIDER_PROTOCOL=native-tasks
IMAGE_TASK_SUBMIT_PATH=/v1/tasks
IMAGE_EDIT_PATH=/v1/images/edits
IMAGE_TASK_PATH=/v1/tasks/{id}
IMAGE_MODEL=gpt-image-2

# 服务端口
PORT=3001

# 访问与商业化计费
SHUBAO_ACCESS_MODE=commercial
SHUBAO_UNLIMITED_EMAILS=867550189@qq.com,240485042@qq.com
SHUBAO_CLOSED_BETA_EMAILS=867550189@qq.com,240485042@qq.com
SHUBAO_ALLOWED_ORIGINS=https://shuimg.cn,https://www.shuimg.cn
SHUBAO_CONTENT_BILLING_CURRENCY=ec_points
SHUBAO_CONTENT_BILLING_UNITS=9000

# 支付渠道暂未启用时保持为空；接入微信/支付宝前必须配置服务端验签适配器。
# PAYMENT_WECHAT_ENABLED=false
# PAYMENT_ALIPAY_ENABLED=false
