# ── 薯包AI 环境变量配置 ──
# 复制为 .env 后填入真实密钥

# LLM API（内容分析 - 主力模型）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Mini API（Vision 分析 - 参考图理解）
MINI_API_KEY=sk-your-key-here
MINI_BASE_URL=https://api2.65535.space
MINI_MODEL=gpt-5.6-luna
VISUAL_ANALYSIS_PROMPT_VERSION=visual-analysis-v3

# 图片生成 API（GPT-Image-2 中转站）
IMAGE_API_KEY=sk-your-key-here
IMAGE_PRIMARY_BASE_URL=https://task-api-1-cn.65535.space
IMAGE_OVERFLOW_BASE_URL=
IMAGE_BASE_URL=
IMAGE_AUTH_STRATEGY=bearer
IMAGE_PROVIDER_PROTOCOL=native-tasks
IMAGE_TASK_SUBMIT_PATH=/v1/tasks
IMAGE_EDIT_PATH=/v1/images/edits
IMAGE_TASK_PATH=/v1/tasks/{id}
IMAGE_MODEL=gpt-image-2

# 服务端口
PORT=3001

# 访问与商业化计费
SHUBAO_ACCESS_MODE=commercial
SHUBAO_UNLIMITED_EMAILS=867550189@qq.com,240485042@qq.com
SHUBAO_CLOSED_BETA_EMAILS=867550189@qq.com,240485042@qq.com
SHUBAO_ALLOWED_ORIGINS=https://shuimg.cn,https://www.shuimg.cn
SHUBAO_CONTENT_BILLING_CURRENCY=ec_points
SHUBAO_CONTENT_BILLING_UNITS=9000

# 支付渠道暂未启用时保持为空；接入微信/支付宝前必须配置服务端验签适配器。
# PAYMENT_WECHAT_ENABLED=false
# PAYMENT_ALIPAY_ENABLED=false

# ── P2 第三方登录（未配置的登录方式不会出现在 /api/auth/providers）──
# GitHub OAuth App：个人主体即可申请 https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# 可选：默认按请求 Host 自动拼回调地址
# GITHUB_OAUTH_REDIRECT_URI=https://shuimg.cn/api/auth/oauth/github/callback

# ── 语音合成 (TTS, 火山引擎 / 豆包语音) ──
# 供应商 = 火山引擎(豆包语音); 鉴权只需一个 API Key, 走请求头 X-Api-Key（无需 APP ID / Token）。
# 配上后 /api/tts/synthesize 与 /api/canvas/tts 自动从 mock 切到真上游;
# 未配置(或仍是 mock-key)时保持 mock 且带 mockAudio:true 标注 —— 诚实门控, 不发任何外部请求。
# 取值: 火山引擎控制台 → 语音技术 → API Key 管理 → 创建/复制 API Key。
# ⚠️ 前置: 需先在「语音技术控制台 → 开通管理」开通「语音合成 2.0」，否则会返回
#    { code: 3001, message: '...requested resource not granted' }（我们已把该错误翻译成中文提示）。
TTS_API_KEY_VOLCENGINE=
# 默认音色(speaker): Seed-TTS 2.0 标准音色, 如 zh_female_vv_uranus_bigtts(Vivi 2.0, 通用) /
# zh_female_cancan_uranus_bigtts(知性灿灿) / zh_female_mizai_uranus_bigtts(黑猫侦探社咪仔, 视频配音);
# 声音复刻音色 id 填 TTS_VOICE_ID_VOLCENGINE, 并把下方 VOLC_TTS_MODEL 设为 seed-icl-2.0。
TTS_VOICE_ID_VOLCENGINE=zh_female_vv_uranus_bigtts
# 可选: 资源/模型/端点覆盖（默认已指向 Seed-TTS 2.0 单向流式 HTTP 同步端点）。
# VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# VOLC_TTS_MODEL=seed-icl-2.0
# VOLC_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
# 其他 provider 同构命名: TTS_API_KEY_<PROVIDER> / TTS_API_SECRET_<PROVIDER>
# (VOLCENGINE / ELEVENLABS / ALIYUN / AZURE / MINIMAX)
