# ── 薯包AI 环境变量配置 ──
# 复制为 .env 后填入真实密钥

# LLM API（内容分析 - 主力模型）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Mini API（Vision 分析 - 参考图理解）
MINI_API_KEY=sk-your-key-here
MINI_BASE_URL=https://your-vision-gateway.example
MINI_MODEL=gpt-5.6-luna
VISUAL_ANALYSIS_PROMPT_VERSION=visual-analysis-v3

# 图片生成 API（GPT-Image-2 中转站）
IMAGE_API_KEY=sk-your-key-here
IMAGE_PRIMARY_BASE_URL=https://task-api-1-cn.65535.space
IMAGE_OVERFLOW_BASE_URL=https://sub-proxy-us.65535.space
IMAGE_AUTH_STRATEGY=bearer
IMAGE_EDIT_PATH=/v1/images/edits
IMAGE_TASK_PATH=/v1/images/tasks/{id}
IMAGE_MODEL=gpt-image-2

# 服务端口
PORT=3001
